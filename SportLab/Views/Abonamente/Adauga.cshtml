@model Abonament
@{
    ViewData["Title"] = "Abonament nou";
}

<h1>Abonament nou</h1>
<p class="text-muted">Completează formularul. Câmpurile marcate în regulament sunt obligatorii.</p>

<form asp-action="Adauga" method="post" class="col-lg-8">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="row">
        <div class="col-md mb-3">
            <label asp-for="NumeComplet" class="form-label"></label>
            <input asp-for="NumeComplet" class="form-control" />
            <span asp-validation-for="NumeComplet" class="text-danger"></span>
        </div>
        <div class="col-md mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="TipAbonament" class="form-label"></label>
        <select asp-for="TipAbonament" asp-items="ViewBag.TipuriAbonament" class="form-select">
            <option value="">— alege tipul —</option>
        </select>
        <span asp-validation-for="TipAbonament" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Program" class="form-label d-block"></label>
        @foreach (string program in ViewBag.Programe)
        {
            <label class="form-check form-check-inline">
                <input type="radio" asp-for="Program" value="@program" class="form-check-input" />
                @program
            </label>
        }
        <span asp-validation-for="Program" class="text-danger d-block"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Activitati" class="form-label"></label>
        <select asp-for="Activitati" asp-items="ViewBag.Activitati" class="form-select" size="5"></select>
        <div class="form-text">Ține apăsat Ctrl ca să alegi mai multe.</div>
        <span asp-validation-for="Activitati" class="text-danger"></span>
    </div>
    <div class="form-check mb-2">
        <input asp-for="AntrenorPersonal" class="form-check-input" />
        <label asp-for="AntrenorPersonal" class="form-check-label"></label>
    </div>
    <div class="form-check mb-3">
        <input asp-for="AcordRegulament" class="form-check-input" />
        <label asp-for="AcordRegulament" class="form-check-label"></label>
        <span asp-validation-for="AcordRegulament" class="text-danger d-block"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Observatii" class="form-label"></label>
        <textarea asp-for="Observatii" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Observatii" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Înscrie-mă</button>
    <a asp-action="Index" class="btn btn-link">Renunță</a>
</form>
