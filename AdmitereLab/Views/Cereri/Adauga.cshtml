@model Cerere
@{
    ViewData["Title"] = "Cerere nouă";
}

<h1>Cerere de admitere</h1>
<p class="text-muted">Admiterea la colegiu, sesiunea 2027. Toate câmpurile, în afară de motivație, sunt obligatorii.</p>

<form asp-action="Adauga" method="post" class="col-lg-8">
    @* Exemplu: un câmp scris cu helpere HTML *@
    <div class="mb-3">
        @Html.Label("NumeComplet", null, new { @class = "form-label" })
        @Html.TextBox("NumeComplet", null, new { @class = "form-control" })
        @Html.ValidationMessage("NumeComplet", null, new { @class = "text-danger" })
    </div>

    <!-- E-mail -->
    <div class="mb-3">
        @Html.Label("Email", null, new { @class = "form-label" })
        @Html.TextBox("Email", null, new { @class = "form-control" })
        @Html.ValidationMessage("Email", null, new { @class = "text-danger" })
    </div>

    <!-- Telefon -->
    <div class="mb-3">
        @Html.Label("Telefon", null, new { @class = "form-label" })
        @Html.TextBox("Telefon", null, new { @class = "form-control" })
        @Html.ValidationMessage("Telefon", null, new { @class = "text-danger" })
    </div>

    <!-- Anul absolvirii (folosind helpere tipizate ...For) -->
    <div class="mb-3">
        @Html.LabelFor(m => m.AnulAbsolvirii, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.AnulAbsolvirii, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.AnulAbsolvirii, null, new { @class = "text-danger" })
    </div>

    <!-- Motivația (zona de text: 4 rânduri, 60 coloane) -->
    <div class="mb-3">
        @Html.Label("Motivatie", null, new { @class = "form-label" })
        @Html.TextArea("Motivatie", null, 4, 60, new { @class = "form-control" })
        @Html.ValidationMessage("Motivatie", null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label asp-for="Specialitate" class="form-label"></label>
        <select asp-for="Specialitate" asp-items="ViewBag.Specialitati" class="form-select">
            <option value="">— alege specialitatea —</option>
        </select>
        <span asp-validation-for="Specialitate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FormaInvatamant" class="form-label d-block"></label>
        @foreach (string forma in ViewBag.FormeInvatamant)
        {
            <label class="form-check form-check-inline">
                <input type="radio" asp-for="FormaInvatamant" value="@forma" class="form-check-input" />
                @forma
            </label>
        }
        <span asp-validation-for="FormaInvatamant" class="text-danger d-block"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="SolicitaCamin" class="form-check-input" />
        <label asp-for="SolicitaCamin" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Trimite cererea</button>
    <a asp-action="Index" class="btn btn-link">Renunță</a>
</form>
